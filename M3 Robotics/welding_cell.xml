<mujoco model="ur5e welding cell">
  <!-- Place this file NEXT TO ur5e.xml (mujoco_menagerie/universal_robots_ur5e/) -->
  <include file="ur5e.xml"/>

  <statistic center="0.4 0 0.3" extent="1.4"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.35 0.35 0.35" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="140" elevation="-28"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
             rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="wood"    rgba="0.87 0.62 0.32 1"/>
    <material name="steel"   rgba="0.30 0.32 0.38 1"/>
    <material name="belt"    rgba="0.10 0.10 0.11 1"/>
    <material name="box"     rgba="0.22 0.22 0.25 1"/>
    <material name="mark"    rgba="0.95 0.85 0.05 1"/>

    <!-- Materials for Chair & Human -->
    <material name="chair_cushion" rgba="0.18 0.20 0.24 1"/>
    <material name="skin"          rgba="0.87 0.72 0.60 1"/>
    <material name="shirt"         rgba="0.20 0.45 0.75 1"/>
    <material name="pants"         rgba="0.15 0.18 0.22 1"/>
    <material name="shoes"         rgba="0.10 0.10 0.10 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Table (top surface z = 0.25) -->
    <geom name="table_top" type="box" pos="0.62 0 0.235" size="0.38 0.85 0.015" material="wood"/>
    <geom type="box" pos="0.30 0.78 0.11" size="0.03 0.03 0.11" material="steel" contype="0" conaffinity="0"/>
    <geom type="box" pos="0.30 -0.78 0.11" size="0.03 0.03 0.11" material="steel" contype="0" conaffinity="0"/>
    <geom type="box" pos="0.94 0.78 0.11" size="0.03 0.03 0.11" material="steel" contype="0" conaffinity="0"/>
    <geom type="box" pos="0.94 -0.78 0.11" size="0.03 0.03 0.11" material="steel" contype="0" conaffinity="0"/>

    <!-- Conveyor (belt top surface z = 0.33), runs along Y -->
    <geom name="belt" type="box" pos="0.45 0 0.29" size="0.14 0.75 0.04" material="belt" contype="0" conaffinity="0"/>
    <geom type="box" pos="0.295 0 0.30" size="0.015 0.75 0.05" material="steel" contype="0" conaffinity="0"/>
    <geom type="box" pos="0.605 0 0.30" size="0.015 0.75 0.05" material="steel" contype="0" conaffinity="0"/>
    
    <!-- Yellow station markers -->
    <geom type="box" pos="0.45 -0.30 0.331" size="0.14 0.004 0.001" material="mark" contype="0" conaffinity="0"/>
    <geom type="box" pos="0.45  0.30 0.331" size="0.14 0.004 0.001" material="mark" contype="0" conaffinity="0"/>

    <!-- Workpieces -->
    <body name="box_a" pos="0.45 -0.13 0.40">
      <joint name="conv_a" type="slide" axis="0 1 0" damping="0"/>
      <geom name="box_a_geom" type="box" size="0.08 0.13 0.07" material="box" contype="0" conaffinity="0"/>
    </body>
    <body name="box_b" pos="0.45 0.13 0.40">
      <joint name="conv_b" type="slide" axis="0 1 0" damping="0"/>
      <geom name="box_b_geom" type="box" size="0.08 0.13 0.07" material="box" contype="0" conaffinity="0"/>
    </body>

    <!-- Chair / Stool (at x = 1.30, facing table at x = 0.62) -->
    <body name="chair" pos="1.30 0 0">
      <!-- Base & Column -->
      <geom type="cylinder" pos="0 0 0.02" size="0.22 0.02" material="steel" contype="0" conaffinity="0"/>
      <geom type="cylinder" pos="0 0 0.18" size="0.03 0.16" material="steel" contype="0" conaffinity="0"/>
      <!-- Seat Cushion -->
      <geom type="box" pos="0 0 0.36" size="0.20 0.22 0.02" material="chair_cushion" contype="0" conaffinity="0"/>
      <!-- Backrest Support & Backrest -->
      <geom type="cylinder" pos="0.16 0 0.50" size="0.015 0.13" material="steel" contype="0" conaffinity="0"/>
      <geom type="box" pos="0.16 0 0.60" size="0.02 0.18 0.10" material="chair_cushion" contype="0" conaffinity="0"/>
    </body>

    <!-- Operator / Human Mannequin (seated at x = 1.25, facing -X toward table) -->
    <body name="operator" pos="1.25 0 0">
      <!-- Pelvis / Lower Torso -->
      <geom type="capsule" fromto="0 -0.10 0.43 0 0.10 0.43" size="0.09" material="pants" contype="0" conaffinity="0"/>

      <!-- Upper Torso / Chest -->
      <geom type="capsule" fromto="0.02 -0.10 0.68 0.02 0.10 0.68" size="0.11" material="shirt" contype="0" conaffinity="0"/>
      <geom type="box" pos="0.01 0 0.55" size="0.08 0.14 0.11" material="shirt" contype="0" conaffinity="0"/>

      <!-- Head and Neck -->
      <geom type="cylinder" pos="0 0 0.77" size="0.04 0.03" material="skin" contype="0" conaffinity="0"/>
      <geom type="sphere" pos="-0.01 0 0.88" size="0.09" material="skin" contype="0" conaffinity="0"/>

      <!-- Thighs -->
      <geom type="capsule" fromto="0 -0.10 0.42 -0.26 -0.10 0.41" size="0.065" material="pants" contype="0" conaffinity="0"/>
      <geom type="capsule" fromto="0  0.10 0.42 -0.26  0.10 0.41" size="0.065" material="pants" contype="0" conaffinity="0"/>

      <!-- Shins -->
      <geom type="capsule" fromto="-0.26 -0.10 0.38 -0.26 -0.10 0.06" size="0.055" material="pants" contype="0" conaffinity="0"/>
      <geom type="capsule" fromto="-0.26  0.10 0.38 -0.26  0.10 0.06" size="0.055" material="pants" contype="0" conaffinity="0"/>

      <!-- Shoes -->
      <geom type="box" pos="-0.29 -0.10 0.025" size="0.08 0.045 0.025" material="shoes" contype="0" conaffinity="0"/>
      <geom type="box" pos="-0.29  0.10 0.025" size="0.08 0.045 0.025" material="shoes" contype="0" conaffinity="0"/>

      <!-- Upper Arms -->
      <geom type="capsule" fromto="0.02 -0.19 0.67 -0.06 -0.17 0.48" size="0.045" material="shirt" contype="0" conaffinity="0"/>
      <geom type="capsule" fromto="0.02  0.19 0.67 -0.06  0.17 0.48" size="0.045" material="shirt" contype="0" conaffinity="0"/>

      <!-- Forearms / Hands -->
      <geom type="capsule" fromto="-0.06 -0.17 0.48 -0.20 -0.11 0.46" size="0.04" material="skin" contype="0" conaffinity="0"/>
      <geom type="capsule" fromto="-0.06  0.17 0.48 -0.20  0.11 0.46" size="0.04" material="skin" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>